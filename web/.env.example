# ─── Next.js Public ───────────────────────────────────────────────────────────
# FastAPI backend URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Origin of the backend. apiFetch appends /api/v1 itself.
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000

# Origin the invitation link an admin shares is built on, no trailing slash.
# Seed S-084 built the page that link lands on: `<origin>/<locale>/invitations/<token>`.
# The origin is its own variable and is deliberately NOT NEXT_PUBLIC_API_URL — ADR-056
# gave that name the browser-facing API origin only, and an invitation link points at
# the web app, not at the API.
#
# Nothing in `web/` reads this yet, and that is the honest state: the code that builds
# the link is the admin-side "send an invitation" screen, which is PR 7 in the `Owed`
# register of docs/SEEDS.md. The name is recorded here so that screen and the backend
# agree on one, rather than each inventing its own.
#
# FINDING for a follow-up seed, read at source 2026-08-26 and NOT fixed here:
# `accept_path` in the create-invitation response is built as
# `f"/api/v1/invitations/{token}/accept"` (backend/app/application/invitation/handlers.py:65)
# and backend/app/schemas/invitation.py:41 comments that "admin shares this". That path
# answers POST only (docs/contracts/rest-invitations-api.md:64), so it is the wrong value
# for its stated purpose now that the shared link is a browser URL. Changing it is backend
# work plus a contract edit, and S-084 does not touch the backend.
NEXT_PUBLIC_INVITE_LINK_ORIGIN=http://localhost:3000

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase anon/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# You do not need real values here to run `pnpm test:e2e`. playwright.config.ts
# supplies obvious placeholders for both variables above to the e2e dev server
# when the shell running the tests has not already set them, so the e2e gate
# gives the same result with or without this file (S-041, docs/SEEDS.md).

# ─── Server-Side Only ─────────────────────────────────────────────────────────
# Supabase service role key — NEVER expose in client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Observability (optional in local dev; leave blank to disable Sentry)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_APP_ENV=development
