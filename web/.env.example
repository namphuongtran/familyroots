# ─── Next.js Public ───────────────────────────────────────────────────────────
# FastAPI backend URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Origin of the backend. apiFetch appends /api/v1 itself.
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase anon/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# You do not need real values here to run `pnpm test:e2e`. playwright.config.ts
# supplies obvious placeholders for both variables above to the e2e dev server
# when the shell running the tests has not already set them, so the e2e gate
# gives the same result with or without this file (S-041, docs/SEEDS.md).

# ─── Server-Side Only ─────────────────────────────────────────────────────────
# Supabase service role key — NEVER expose in client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Observability (optional in local dev; leave blank to disable Sentry)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_APP_ENV=development
