# Root .env for docker-compose. Copy to `.env` and fill in real values.
#   cp .env.example .env
# NOTE: `.env` is gitignored — never commit real secrets. This file is placeholders only.

# ─── Database (pgdb) ──────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=family_roots

# ─── Backend API (api) ────────────────────────────────────────────────
APP_SECRET_KEY=changeme

# Supabase project URL (also used to fetch the JWKS for JWT verification).
SUPABASE_URL=https://xxxx.supabase.co

# Anon (public) key — used by the API's sign-in (anon client).
# This is the SAME value as NEXT_PUBLIC_SUPABASE_ANON_KEY below; the backend just
# reads it under this (non-prefixed) name. Required for login.
SUPABASE_ANON_KEY=your-anon-key

# Service-role (SECRET) key — used to create users on register + Storage uploads.
# Get it from Supabase dashboard → Project Settings → API → service_role. Required
# for register + document upload. Keep secret (never expose to the web client).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: current code verifies JWTs via JWKS (RS256), so this is NOT required.
# Left here only because docker-compose passes it through.
SUPABASE_JWT_SECRET=

# Optional (compose defaults to family-roots-files).
SUPABASE_STORAGE_BUCKET=family-roots-files

# ─── pgAdmin ─────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@familyroots.dev
PGADMIN_DEFAULT_PASSWORD=changeme

# ─── Web (web) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL the web app uses to reach the (Python/FastAPI) backend API — used by
# web/src/lib/api/axios.ts and server-side fetches in auth-context.ts.
# Optional: compose defaults to http://api:8000/api/v1. Inside Docker keep the
# `api` service host (SSR runs in the web container, so `localhost` would point at
# the web container, not the API). Only override for a non-Docker setup.
NEXT_PUBLIC_API_URL=http://api:8000/api/v1
