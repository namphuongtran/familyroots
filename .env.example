# Root .env for docker-compose. Copy to `.env` and fill in real values.
#   cp .env.example .env
# NOTE: `.env` is gitignored — never commit real secrets. This file is placeholders only.

# ─── Database (pgdb) ──────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=family_roots

# ─── Backend API (api) ────────────────────────────────────────────────
APP_SECRET_KEY=changeme

# Supabase project URL (also used to fetch the JWKS for JWT verification).
#
# LOCAL DEVELOPMENT: run the stack in `supabase/` and use the value below instead. It is
# `supabase.localhost`, NOT the `http://127.0.0.1:54321` that `supabase status` prints. The
# token issuer must match this string byte for byte, and 127.0.0.1 cannot mean both the host
# and the inside of a container. Pasting the 127.0.0.1 value gives 401 invalid_token against a
# perfectly healthy stack. Full account: docs/ops/local-supabase.md.
#   scripts/supabase_local.sh up
#   scripts/supabase_local.sh env   # prints the three values below, filled in
#   SUPABASE_URL=http://supabase.localhost:54321
SUPABASE_URL=https://xxxx.supabase.co

# Anon (public) key — used by the API's sign-in (anon client).
# This is the SAME value as NEXT_PUBLIC_SUPABASE_ANON_KEY below; the backend just
# reads it under this (non-prefixed) name. Required for login.
SUPABASE_ANON_KEY=your-anon-key

# Service-role (SECRET) key — used to create users on register + Storage uploads.
# Get it from Supabase dashboard → Project Settings → API → service_role. Required
# for register + document upload. Keep secret (never expose to the web client).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: current code verifies JWTs via JWKS (RS256), so this is NOT required.
# Left here only because docker-compose passes it through.
SUPABASE_JWT_SECRET=

# Optional (compose defaults to family-roots-files).
SUPABASE_STORAGE_BUCKET=family-roots-files

# ─── pgAdmin ─────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@familyroots.dev
PGADMIN_DEFAULT_PASSWORD=changeme

# ─── Web (web) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ADR-056 / seed S-076: NEXT_PUBLIC_API_URL and API_URL are two different values now,
# because NEXT_PUBLIC_API_URL is inlined into the browser bundle at `docker compose
# build web` time (Next.js bakes every NEXT_PUBLIC_* reference, browser and server
# code alike — see web/Dockerfile's own comment). One baked value cannot serve both a
# browser on the host and a server running inside the `web` container, so each has its
# own variable:
#
# The URL a BROWSER on the host uses to reach the backend API. Baked into the image at
# build time — optional, compose defaults to http://localhost:8000/api/v1, since `api`
# publishes port 8000 to the host. Rebuild (`docker compose build web`) after changing
# this; a running container does not see a new value.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# The URL the web app's SERVER half (src/lib/server/auth-context.ts) uses to reach the
# backend API, from inside the `web` container. Read live at request time, never baked
# — optional, compose defaults to http://api:8000/api/v1, the compose-network hostname
# (SSR runs in the web container, so `localhost` here would point at the web container,
# not the API). Only override for a deployment shape where the server-to-server origin
# differs from this default.
API_URL=http://api:8000/api/v1
