# App
APP_ENV=development                      # development | staging | production
APP_SECRET_KEY=change-me-in-production
APP_DEBUG=true
APP_PORT=8000

# Supabase / PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/family_roots
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Storage — PRIVATE bucket, path-based clan isolation. Read only via presigned URLs:
#   family-roots-files/clans/{clan_id}/documents/
#   family-roots-files/clans/{clan_id}/events/
SUPABASE_STORAGE_BUCKET=family-roots-files

# Avatars — a SEPARATE, deliberately PUBLIC-READ bucket (ADR-036). Anything here is
# fetchable by anyone with the URL, unauthenticated, forever, across clans:
#   family-roots-avatars/clans/{clan_id}/avatars/{person_id}
# Create it by hand in the Supabase dashboard with public read enabled; until it
# exists, PATCH /documents/{id}/set-avatar returns 503 storage_bucket_not_configured.
# Never point this at SUPABASE_STORAGE_BUCKET — that would make every document public.
SUPABASE_AVATAR_BUCKET=family-roots-avatars
# Cache-Control max-age on published avatars. The object path is stable per person, so
# this is how long a replaced portrait can still be served from a cache.
AVATAR_CACHE_CONTROL_SECONDS=300

# Firebase FCM
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Sentry
SENTRY_DSN=https://xxxx@sentry.io/xxxx

# Prometheus RED metrics at GET /internal/metrics — off by default. When enabled,
# METRICS_TOKEN is REQUIRED (boot fails without it) and the scraper must send it as
# the X-Metrics-Token header; every failure path returns 404, never 401 (ADR-021/033).
# Use ASCII (e.g. a hex string) — the comparison is byte-exact so a non-ASCII value
# only authenticates if the scraper sends the identical raw bytes, which is brittle
# across shells/env files and easy to get wrong; ASCII sidesteps that entirely.
METRICS_ENABLED=false
METRICS_TOKEN=                           # long random string, e.g. `openssl rand -hex 32`

# Scheduler
NOTIFICATION_CRON_HOUR=7                 # Run daily at 7 AM (local server time)

# Password reset
PASSWORD_RESET_REDIRECT_URL=        # e.g. https://app.example.com/reset-password (empty → Supabase Site URL)
EMAIL_VERIFY_REDIRECT_URL=          # e.g. https://app.example.com/verify-email (empty → Supabase Site URL)

# Rate limiting / audit IP resolution — REQUIRED explicitly in production (boot
# fails if unset): true behind a trusted proxy/LB (Render), false when directly
# exposed. Unset in development resolves to false.
RATE_LIMIT_TRUST_FORWARDED_FOR=true
