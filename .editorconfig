# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python — 4 spaces
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# Dart — 2 spaces
[*.dart]
indent_style = space
indent_size = 2

# YAML — 2 spaces
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# JSON
[*.json]
indent_style = space
indent_size = 2

# TOML
[*.toml]
indent_style = space
indent_size = 4

# Makefiles require tabs
[Makefile]
indent_style = tab

# Docker
[Dockerfile]
indent_style = space
indent_size = 4

# SQL
[*.sql]
indent_style = space
indent_size = 2

# Mako templates
[*.mako]
indent_style = space
indent_size = 4
